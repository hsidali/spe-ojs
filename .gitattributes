# Files that run or are read on Linux must keep LF line endings, even when the repo is
# checked out on Windows (core.autocrlf=true would turn them into CRLF and break them).
*.sh        text eol=lf
*.template  text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env*       text eol=lf
*.htaccess  text eol=lf
Dockerfile  text eol=lf
