# === Credentials / Environment ===
.env
.env.*
!.env.example

# Generated from volumes/config/pkp.config.inc.php.template + .env by
# scripts/render-config.sh. It contains secrets: never commit it.
volumes/config/pkp.config.inc.php

# === Backups (database dumps + secrets) ===
backups/
*.sql.gz

# === Runtime volume data ===
# Database data files (MariaDB/MySQL) — NEVER commit
volumes/db/

# Logs (app and db)
volumes/logs/

# Private runtime files (uploads, scheduled tasks, temp, usage stats)
volumes/private/

# Public uploads (journal cover images, etc.)
volumes/public/

# SQL auto-import dump (only runs on first DB creation)
volumes/db-import/

